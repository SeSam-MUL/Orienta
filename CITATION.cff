# Citation File Format — https://citation-file-format.github.io/
# GitHub reads this for the "Cite this repository" button; Zenodo imports it too.
cff-version: 1.2.0
message: "If you use this software, please cite it using these metadata."
title: "Orienta"
abstract: >-
  Desktop application for EBSD (electron backscatter diffraction) pattern
  analysis: load Oxford H5OINA / EDAX H5 data, refine the pattern center, index
  crystal phases (Hough / Dictionary / Spherical), integrate EDS chemistry, and
  produce phase maps, grain/texture analyses, and publication figures.
type: software
authors:
  - given-names: "Sebastian"
    family-names: "Samberger"
    orcid: "https://orcid.org/0009-0000-2559-0172"
    affiliation: "Montanuniversität Leoben"
  - given-names: "Stefan"
    family-names: "Pogatscher"
    orcid: "https://orcid.org/0000-0002-6500-9570"
    affiliation: "Montanuniversität Leoben"
  - given-names: "Equo"
    family-names: "Kobayashi"
    orcid: "https://orcid.org/0000-0001-8043-5044"
    affiliation: "Tokyo Institute of Technology"
  - given-names: "Irmgard"
    family-names: "Weißensteiner"
    orcid: "https://orcid.org/0000-0002-8917-5231"
    affiliation: "Montanuniversität Leoben"
version: "0.2.5"
date-released: "2026-09-08"
license: "GPL-3.0-or-later"
repository-code: "https://github.com/SeSam-MUL/Orienta"
# The concept DOI always resolves to the newest archived version — that is what
# a general "we used Orienta" citation should point at. The DOI of this exact
# release is listed below under identifiers.
url: "https://doi.org/10.5281/zenodo.21021937"
doi: "10.5281/zenodo.21021937"
keywords:
