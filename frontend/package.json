{
  "name": "kikuchipy-gui",
  "private": true,
  "version": "0.4.6",
  "description": "EBSD Pattern Analysis GUI",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/third_party_licenses.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently --kill-others --success first --names \"vite,electron\" --prefix-colors \"blue,green\" \"npm run dev\" \"wait-on http://localhost:5173 && electron ../electron/main.js\"",
    "electron:build": "npm run build && electron-builder",
    "test:electron": "vitest run --config vitest.electron.config.js",
    "test:all": "npm test -- --run && npm run test:electron"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "i18next": "^26.3.2",
    "lucide-react": "^0.577.0",
    "plotly.js": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "react-window": "^2.2.7",
    "three": "^0.183.2",
    "vanta": "^0.5.24",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.kikuchipy.gui",
    "productName": "Orienta",
    "asar": false,
    "extraMetadata": {
      "type": "commonjs",
      "main": "electron/main.js"
    },
    "directories": {
      "output": "../release/dist"
    },
    "files": [
      "package.json",
      "!node_modules/**/*",
      {
        "from": "../electron",
        "to": "electron",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!nsis/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../resources",
        "to": "resources",
        "filter": [
          "icon.png"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "bundled-runtime",
        "to": ".",
        "filter": [
          "orienta-runtime-*.zip",
          "orienta-runtime-*.zip.sha256"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Orienta",
      "include": "../electron/nsis/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "../resources/icon-1024.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "14.0",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../resources/icon-1024.png",
      "category": "Science"
    }
  }
}
