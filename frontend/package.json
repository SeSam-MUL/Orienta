{
  "name": "kikuchipy-gui",
  "private": true,
  "version": "1.0.0",
  "description": "EBSD Pattern Analysis GUI",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "../electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently --kill-others --success first --names \"vite,electron\" --prefix-colors \"blue,green\" \"npm run dev\" \"wait-on http://localhost:5173 && electron ../electron/main.js\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "i18next": "^26.3.2",
    "lucide-react": "^0.577.0",
    "plotly.js": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "react-window": "^2.2.7",
    "three": "^0.183.2",
    "vanta": "^0.5.24",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^36.9.5",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.kikuchipy.gui",
    "productName": "Orienta",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "dist/**/*",
      "../electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science"
    }
  }
}
