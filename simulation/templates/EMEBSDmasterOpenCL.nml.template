 &EBSDmastervars
 ! kleinster d-Spacing [nm]
 dmin = {dmin},
 !
 ! Anzahl der Pixel in x-Richtung (halbe Groesse des Master-Patterns)
 npx = {npx},
 !
 ! Anzahl Threads (MUSS Form 4N+3 haben: 7, 11, 15, 19, ...)
 ! Section 1: 3*(nthreads-3)/4 pre-processing threads
 ! Section 2: 1 GPU management thread
 ! Section 3: (nthreads-3)/4 post-processing threads
 nthreads = {nthreads},
 !
 ! HDF5-Datei mit Monte-Carlo-Daten (relativ zu EMdatapathname)
 energyfile = '{energyfile}',
 !
 ! Bethe-Parameter-Datei
 BetheParametersFile = '{BetheParametersFile}',
 !
 ! OpenCL Platform ID (1-basiert)
 platid = {platid},
 !
 ! OpenCL Device ID (1-basiert, NUR GPU-Devices gezaehlt!)
 devid = {devid},
 !
 ! Anzahl Work Items pro Kernel-Launch
 globalworkgrpsz = {globalworkgrpsz},
 !
 ! Block-Groesse fuer k-Vektor-Verarbeitung (Potenz von 2)
 ! Bestimmt GPU-Speicherverbrauch: blocksize=32 -> ~8-16GB, blocksize=16 -> ~2-4GB
 blocksize = {blocksize},
 !
 ! Restart-Flag (fuer unterbrochene Laeufe)
 restart = .FALSE.,
 !
 ! Gleichfoermiges Master-Pattern (Debug: alle Intensitaeten = 1.0)
 uniform = .FALSE.,
 !
 ! Kopie von MC-Daten aus anderer Datei (normalerweise 'undefined')
 copyfromenergyfile = 'undefined',
 h5copypath = 'undefined',
 /
